<?xml version="1.0" encoding="utf-8"?>
<!--
  SplashScreen 自己的 logo（windowSplashScreenAnimatedIcon）。
  不能直接复用 adaptive icon：SplashScreen 要的是一个 240 视口、图形占中心约 2/3 的单张
  drawable，而 adaptive 层是 108 视口 + 中心 66 安全区，两者缩放规则不同。
  里面这块蓝底圆角方块 + 白色标记和 launcher 图标是同一个形状，所以冷启动那一帧和桌面上
  的图标对得上。

  缩放：外层 group 把 108 坐标映到 240 视口（240/108），内层 group 把标记放大 1.35 倍
  ——相框在启动画面上要比 launcher 前景里的比例更满一点，才撑得住 240dp 的视觉尺寸。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="2.222222"
        android:scaleY="2.222222">
        <path
            android:fillColor="@color/icon_background"
            android:pathData="M26,2 L82,2 A24,24 0 0 1 106,26 L106,82 A24,24 0 0 1 82,106 L26,106 A24,24 0 0 1 2,82 L2,26 A24,24 0 0 1 26,2 Z" />
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:scaleX="1.35"
            android:scaleY="1.35">
            <path
                android:pathData="M41,38 L57,38 A7,7 0 0 1 64,45 L64,63 A7,7 0 0 1 57,70 L41,70 A7,7 0 0 1 34,63 L34,45 A7,7 0 0 1 41,38 Z"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="5"
                android:strokeLineJoin="round" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M45,47 L45,61 L57,54 Z" />
            <path
                android:fillColor="#FFFFFFFF"
                android:fillType="evenOdd"
                android:pathData="M73,38 L75,38 A3,3 0 0 1 78,41 L78,67 A3,3 0 0 1 75,70 L73,70 A3,3 0 0 1 70,67 L70,41 A3,3 0 0 1 73,38 Z M72,43 L76,43 L76,47 L72,47 Z M72,52 L76,52 L76,56 L72,56 Z M72,61 L76,61 L76,65 L72,65 Z" />
        </group>
    </group>
</vector>
