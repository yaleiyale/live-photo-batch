<?xml version="1.0" encoding="utf-8"?>
<!--
  adaptive icon 前景层：一张静止帧（圆角相框 + 播放三角）右边接一小段胶片齿孔——
  画的就是这个 app 做的事：照片尾部追加一段视频。

  纯白单色不是审美选择，是为了让同一份文件同时当 <monochrome> 层用（Android 13+ 主题图标
  会把它重染成用户主题色），少一份会各自漂移的副本。

  尺寸边界：前景可画的安全区是居中 66×66，圆形遮罩内切半径 33。所有描边外缘到画布中心
  (54,54) 的距离都控制在 33 以内，最远的是相框左上角 (31.5,35.5) ≈ 29.1，齿孔条右下角
  (78,70) ≈ 28.8，所以圆形 launcher 不会啃掉图形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 相框：描边画圆角矩形，不填充，留出中间的播放三角 -->
    <path
        android:pathData="M41,38 L57,38 A7,7 0 0 1 64,45 L64,63 A7,7 0 0 1 57,70 L41,70 A7,7 0 0 1 34,63 L34,45 A7,7 0 0 1 41,38 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />
    <!-- 播放三角：形心 (49,54) 落在相框内腔 (36.5..61.5 × 40.5..67.5) 正中 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M45,47 L45,61 L57,54 Z" />
    <!-- 胶片齿孔条：一个实心圆角条 + 三个方孔，evenOdd 把孔挖成真透明（不是画成背景色），
         这样重染成单色的主题图标里孔仍然看得见 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M73,38 L75,38 A3,3 0 0 1 78,41 L78,67 A3,3 0 0 1 75,70 L73,70 A3,3 0 0 1 70,67 L70,41 A3,3 0 0 1 73,38 Z M72,43 L76,43 L76,47 L72,47 Z M72,52 L76,52 L76,56 L72,56 Z M72,61 L76,61 L76,65 L72,65 Z" />
</vector>
