<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 唯一的读写门是「所有文件访问」：批次在没授权时根本不开工，minSdk 31 上它覆盖了
         READ_EXTERNAL_STORAGE 能给的一切，所以不再声明后者。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".VliveApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Vlive.Starting">
        <!-- android:name 的点号前缀展开的是 namespace（dev.zayn.vlive），不是包目录名，
             所以 MainActivity 必须就留在这个包下。完整组件名：
             dev.zayn.vlive/dev.zayn.vlive.MainActivity（`am start` 用的就是这一串）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <!-- screenOrientation：这一屏是竖版单屏设计（卡片、两条玻璃 bar、目录弹窗都按手机竖屏排），
                 横向一套布局都没有。锁掉还顺带挡住转屏带来的整窗重建：入场动画与 splash 衔接会从头再走一遍。
                 折叠屏内屏的宽度问题由 IosMetrics.contentMaxWidth 封顶解决，不靠横屏。
                 两条 ignore 各对应一条真实告警：LockedOrientationActivity 是 Google 对 ChromeOS/大屏的
                 通用建议；DiscouragedApi 的原文是「Android 16 起多数情况下固定方向会被忽略」，
                 也就是说这条约束在更新的系统上可能不再被遵守。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
